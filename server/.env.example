# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (MongoDB) ──────────────────────────────────────────────────────
# Atlas connection string (free M0 tier provides a replica set, which the
# multi-document transactions in payment confirmation require).
# For local development without MongoDB installed, run `npm run dev:memory`
# instead of `npm run dev` — it starts an in-memory replica set automatically.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/velora?retryWrites=true&w=majority

# ─── Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
ACCESS_TOKEN_SECRET=replace-with-48-byte-random-hex
REFRESH_TOKEN_SECRET=replace-with-different-48-byte-random-hex
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=30

# ─── CORS allow-list (comma-separated origins of the frontend(s)) ────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Pricing (flat-rate simplifications per PRD §21 Phase 6) ─────────────────
# Currency is INR. Amounts sent to Razorpay are converted to paise (×100).
TAX_RATE_PERCENT=18
SHIPPING_FLAT_RATE=49

# ─── Business rules ──────────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5
RETURN_WINDOW_DAYS=7

# ─── Payments (Razorpay test mode) ───────────────────────────────────────────
# Get test keys from https://dashboard.razorpay.com/app/keys (test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# MOCK_PAYMENTS=true lets the full checkout flow run locally without Razorpay
# keys (a fake gateway signs/verifies with the same HMAC logic). It is hard-blocked
# in production by config/env.js.
MOCK_PAYMENTS=true

# ─── Seed script (npm run seed) ──────────────────────────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@velora.dev
ADMIN_PASSWORD=ChangeMe123!

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
