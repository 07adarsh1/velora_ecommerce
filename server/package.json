{
  "name": "velora-server",
  "version": "1.0.0",
  "description": "Velora e-commerce API — Express + MongoDB (layered monolith: routes → controllers → services → models)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:memory": "node src/scripts/dev-memory.js",
    "seed": "node src/scripts/seed.js",
    "seed:images": "node src/scripts/set-product-images.js",
    "images:local": "node src/scripts/upload-local-images.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pino": "^9.6.0",
    "razorpay": "^2.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "globalTeardown": "<rootDir>/tests/global-teardown.js",
    "testTimeout": 30000
  }
}
